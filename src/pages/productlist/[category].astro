---
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/Card.astro";

export async function getStaticPaths() {
  const respons = await fetch("https://kea-alt-del.dk/t7/api/categories/");
  const categories = await respons.json();
  return categories.map((cat) => ({
    params: { category: cat.category },
  }));
}

const { category } = Astro.params;

const response = await fetch(`https://kea-alt-del.dk/t7/api/products?category=${category}`);
const data = await response.json();
console.log(data);
---

<Layout>
  <h1>{category}</h1>
  <section class="productlist">
    <main>
      {data.map((product) => <Card data={product} />)}
    </main>
  </section>
</Layout>
