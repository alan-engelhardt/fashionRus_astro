---
import Card from "../components/card.astro";
import Layout from "../layouts/Layout.astro";
const endpoint = "https://flxrgxrvxeximsskwubc.supabase.co/rest/v1/test";
const key = "sb_publishable_blXxApPlyxDnCVHdrO_sEA__Nmc254r";

const options = {
	headers: {
		apikey: key,
	},
};
const data = await fetch(endpoint, options).then((res) => res.json());
---

<Layout>
	<main>
		<h1>Produkter</h1>
		<section>
			{data.map((product) => <Card {product} />)}
		</section>
	</main>
</Layout>

<style>
	main {
		max-width: 1200px;
		margin: auto;
	}
	section {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
		gap: 1rem;
	}
</style>
