---
const { soldout, productdisplayname, articletype, brandname, price, discount, id } = Astro.props;
---

<article class={soldout ? "soldOut smallProduct" : "smallProduct"}>
  <img src=`https://kea-alt-del.dk/t7/images/webp/640/${id}.webp` alt="product image" />
  <h3>{productdisplayname}</h3>
  <p class="subtle">{articletype} | {brandname}</p>
  <p class="price">DKK <span>{price}</span>,-</p>
  {
    discount && (
      <div class="discounted">
        <p>
          Now DKK <span>{Math.round(price - (price * discount) / 100)}</span>,-
        </p>
        <p>
          <span>{discount}</span>%
        </p>
      </div>
    )
  }
  <a href="product.html/" {id}>Read More</a>
</article>
