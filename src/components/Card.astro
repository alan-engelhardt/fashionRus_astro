---
const { product } = Astro.props;
---

<article>
    <h2>{product.name}</h2>
    <img src={"/img/" + product.images[0]} alt="product image" />
    <img src={"/img/" + product.images[1]} alt="product image" />
</article>

<style>
    img {
        max-width: 100%;
        margin: 0;
    }
</style>
